config_version=5

[application]
config/name="Tripothon — Character Atelier"
run/main_scene="res://lab.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/min_width=1100
window/size/min_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=3
textures/default_filters/use_nearest_mipmap_filter=false
