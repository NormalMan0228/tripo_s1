[gd_resource type="FontVariation" load_steps=4 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Pretendard-SemiBold.woff" id="1_base"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSansSC-Bold.woff" id="2_fb"]

[sub_resource type="SystemFont" id="SystemFont_os"]
font_names = PackedStringArray("Malgun Gothic", "Microsoft YaHei", "Apple SD Gothic Neo", "PingFang SC", "Noto Sans CJK KR", "Noto Sans CJK SC", "Segoe UI Emoji", "Segoe UI Symbol", "sans-serif")

[resource]
