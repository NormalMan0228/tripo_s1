extends RefCounted
## ISS-1 authored sockets for fixed assets (data in code: client JSON outside the export filter would
## not ship in a PCK, and the interior/environment JSON files are regenerated by tools).
##
## Room furniture (Interiors records): `at` is fractions of the piece's box (x and z from the centre
## -0.5..0.5, y from the floor 0..1), +Z its front. `snap` drops the point onto the real mesh below
## at + 0.25 m. width_frac/depth_frac/length_frac are fractions of the box.
const INTERIOR_KINDS := {
	"wooden_chair": [{"id": "seat_0", "type": "sit", "variant": "chair", "at": [0, 0.5, 0.08], "params": {"back": true, "width_frac": 0.9, "depth_frac": 0.85}}],
	"armchair": [{"id": "seat_0", "type": "sit", "variant": "armchair", "at": [0, 0.5, 0.10], "params": {"back": true, "arms": true, "width_frac": 0.6, "depth_frac": 0.6}}],
	"sofa": [{"id": "seat_0", "type": "sit", "variant": "sofa", "at": [0, 0.5, 0.10], "params": {"back": true, "arms": true, "width_frac": 0.8, "depth_frac": 0.6},
		"repeat": {"axis": "x", "pitch": 0.5, "min_width": 0.45}}],
	"bench": [{"id": "seat_0", "type": "sit", "variant": "bench", "at": [0, 0.5, 0.0], "params": {"width_frac": 0.9, "depth_frac": 0.8},
		"repeat": {"axis": "x", "pitch": 0.55, "min_width": 0.45}}],
	# A bed lies along its length (head at -Z); it is entered from either long side, edge seats too.
	"bed": [
		{"id": "lie_0", "type": "lie", "variant": "bed", "group": "bed", "at": [0, 0.5, 0.05], "yaw": 90, "params": {"head": "l", "length_frac": 0.9, "width_frac": 0.9}},
		{"id": "lie_1", "type": "lie", "variant": "bed", "group": "bed", "at": [0, 0.5, 0.05], "yaw": -90, "params": {"head": "r", "length_frac": 0.9, "width_frac": 0.9}},
		{"id": "edge_0", "type": "sit", "variant": "bench", "at": [0.36, 0.5, 0.18], "yaw": 90, "params": {"back": false, "width": 0.5, "depth": 0.45}},
		{"id": "edge_1", "type": "sit", "variant": "bench", "at": [-0.36, 0.5, 0.18], "yaw": -90, "params": {"back": false, "width": 0.5, "depth": 0.45}}],
	"bathtub": [{"id": "lie_0", "type": "lie", "variant": "bathtub", "at": [0.08, 0.4, 0], "snap": false, "params": {"head": "r", "sunk": true, "length_frac": 0.9, "width_frac": 0.8}}],
	"toilet": [{"id": "seat_0", "type": "sit", "variant": "stool", "at": [0, 0.5, 0.12], "params": {"back": false, "width": 0.4, "depth": 0.4}}],
}
## Interiors.ACTIONS kinds that are used standing get one stand_use socket in front (data for WP12).
const STAND_USE_SKIP := ["sit", "lie", "travel"]

