## The socket records of a room piece kind (normalised later by ix_sources).
static func interior(kind: String, action := "") -> Array:
	if INTERIOR_KINDS.has(kind): return INTERIOR_KINDS[kind].duplicate(true)
	if not action.is_empty() and not action in STAND_USE_SKIP:
		return [{"id": "use_0", "type": "stand_use", "at": [0, 0, 0.5], "off": [0, 0, 0.35], "yaw": 180, "snap": false,
			"params": {"kind": action, "work_height_frac": 1.0}}]
	return []

## A swing, rocker or hammock of field_objects.gd as a socket record carried by its pivot (WP8 wires it).
static func from_field_entry(entry: Dictionary) -> Array:
	var kind := str(entry.get("kind", ""))
	if not kind in ["swing", "rocker", "hammock"]: return []
	var seat_local: Vector3 = entry.get("seat_local", Vector3.ZERO)
	var front: Vector2 = entry.get("front", Vector2(0, 1))
	return [{"id": "seat_0", "type": "lie" if kind == "hammock" else "sit", "variant": kind, "carrier": "pivot", "pos": [seat_local.x, seat_local.y, seat_local.z],
		"yaw": rad_to_deg(atan2(front.x, front.y)), "follow": "full", "snap": false, "source": "authored", "params": {"width": 0.5, "depth": 0.4}}]
