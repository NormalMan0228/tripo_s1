extends SceneTree
## A crafted character (task 67): an assembly built from a skinned GLB with idle and walk clips (the
## server's own fixture, server/rigged_glb.py, embedded below) loops idle, its bones move once it is
## shown (rig_moving), walk can be played, and a craft without a rig gets no player started.
const Assembly = preload("res://scripts/asset_assembly.gd")
const RigMotion = preload("res://scripts/rig_motion.gd")
const RIGGED := ""
var failed := false

func expect(value: bool, description: String) -> void:
	print(("PASS " if value else "FAIL ") + description)
	if not value: failed = true

func _initialize() -> void:
	call_deferred("run")

func manifest(rig: Dictionary) -> Dictionary:
	return {"schema": 1, "plan": {"title": "robot", "category": "character", "parts": [{"id": "whole", "parent": "", "prompt": "robot",
		"shape": "box", "size": [0.6, 1.6, 0.4], "position": [0, 0.8, 0], "rotation": [0, 0, 0], "pivot": [0, 0, 0], "color": "#c9a46e"}]},
		"program": {"version": 1, "state": {}, "functions": {}, "events": {}},
		"provenance": {"geometry": "tripo", "rig": rig}, "runtime": {"state": {}, "colors": {}, "version": 1}}

func run() -> void:
	var blob := Marshalls.base64_to_raw(RIGGED)
	var rig := {"status": "ok", "rig_type": "biped", "clips": ["idle", "walk"], "default_clip": "idle", "moves": true}
	var character: Node3D = Assembly.new()
	expect(character.build(manifest(rig), {"whole": blob}), "a skinned GLB with two clips builds")
	var player: AnimationPlayer = RigMotion.players(character)[0] if not RigMotion.players(character).is_empty() else null
	expect(player != null and player.has_animation("idle") and player.has_animation("walk") and player.autoplay == "idle", "its idle clip is set to play")
	expect(not RigMotion.skeletons(character).is_empty(), "it has a skeleton")
	root.add_child(character)
	await create_timer(0.8).timeout
	expect(character.get_meta("rig_moving", false) == true and player.is_playing() and player.current_animation == "idle", "shown, idle plays and the bones move")
	expect(player.get_animation("idle").loop_mode == Animation.LOOP_LINEAR, "idle loops")
	expect(RigMotion.play(character, "walk") and player.current_animation == "walk", "walk can be played")
	expect(not RigMotion.play(character, "dance"), "an unknown clip is refused")
	var before := RigMotion.pose(character)
	await create_timer(0.3).timeout
	expect(before != RigMotion.pose(character), "walking moves the bones too")
	# The same model without the server's rig marker: nothing is started.
	var still: Node3D = Assembly.new()
	expect(still.build(manifest({}), {"whole": blob}), "the same model builds as a still craft")
	var players := RigMotion.players(still)
	expect(not still.has_meta("rig") and (players.is_empty() or players[0].autoplay == ""), "a craft without a rig marker plays nothing")
	character.queue_free()
	still.free()
	print("RIG_MOTION " + ("FAILED" if failed else "OK"))
	quit(1 if failed else 0)
