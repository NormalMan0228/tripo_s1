# Large generated art kept locally only (not pushed to GitHub)
output/
art/maps/
art/characters/npc_cast_*/
art/characters/explorer_b_modular_v1/
labs/terrain_lab/assets/
labs/archipelago_object_lab/assets/
labs/archipelago_object_lab/reviews/
*.zip

# The archipelago map binaries are copied from labs/terrain_lab by tools/port_archipelago_map.py.
game/maps/archipelago/assets/
# Working list written by tools/i18n_catalog.py extract.
game/i18n/source.json
.cc5_bridge/

# NPC cast models and portraits stay local like the other NPC art (copied from art/characters/npc_cast_*).
game/assets/npc/
game/assets/portraits/

# Tripo interior furniture (about 70 MB of GLBs plus imported textures) stays local like the map.
# The manifest records every item, its model and credits; tools/generate_interior_assets.py rebuilds the set.
game/assets/interior/*
!game/assets/interior/manifest.json

# Tripo survival monsters (15 rigged/animated GLBs, ~21 MB plus imported textures) stay local like the other
# Tripo art. The manifest records every monster, Tripo task and credit; tools/generate_monsters.py
# (re-download is free while the tasks exist) and tools/build_monsters.py rebuild the set.
game/assets/monsters/*
!game/assets/monsters/manifest.json

# Tripo survival map props (GLBs + LOD1 + extracted textures, ~25 MB) stay local like the interiors.
# manifest.json records every prop, its model and credits; tools/generate_survival_assets.py +
# tools/build_survival_assets.py rebuild the set.
game/maps/survival/assets/*
!game/maps/survival/assets/manifest.json
