# Template only. Do not commit real secrets. Launch scripts do not auto-read this file.
TRIPOTHON_MODE=demo
TRIPOTHON_DATA_DIR=server-data
TRIPO_ENABLE_PAID=false
TRIPO_DAILY_REQUEST_LIMIT=5
TRIPO_RESERVE_PER_JOB=200
TRIPO_MODEL=P2-20260801
TRIPOTHON_STUDIO_LLM=fixture
# classic is the measured default. structured is an experimental strict JSON schema wire format.
TRIPOTHON_DESIGN_FORMAT=classic
TRIPOTHON_STARS_PER_CREDIT=1
# Final studio quote = max(design reservation, ceil(estimated credits * conversion)).
# Remaining game currency is reserved at confirmation, before paid POST.
# codex = local subscription development only; openai = paid Responses API.
# OPENAI_API_KEY is server-only and must be configured outside this file.
# Configure TRIPO_API_KEY only in the server's secret environment.
# Alternatively set TRIPO_API_KEY_FILE to a server-local UTF-8 file outside this project.
# Never configure both sources. The game must not receive either secret.
# Live mode additionally requires TRIPOTHON_REGISTRATION_CODE (24+ characters), HTTPS,
# and a DIFFERENT TRIPOTHON_DATA_DIR. Demo balances cannot enter the live economy.
