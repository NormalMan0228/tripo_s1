# Development server settings. ops/install_staging.sh copies this to ops/staging.env in the staging
# checkout (/opt/villagen-staging) and fills VILLAGEN_PROD_DIR; ops/staging.sh changes the rest.
# Never put keys or invitation codes here.
# The school server checkout: its Tripo/Gemini key files are used only in real mode.
VILLAGEN_PROD_DIR=/home/ubuntu/tripo_s1
# fake = built-in stand-in for Tripo (free, instant); real = real Tripo within the budget below.
STAGING_CRAFT=fake
# Seconds a fake task "runs" before it finishes (0 = at once; try 20 to see the progress bar).
STAGING_FAKE_SECONDS=0
# Real mode only: Tripo credits the development server may spend in total, and per craft.
STAGING_TRIPO_BUDGET=0
STAGING_MAX_CREDITS_PER_CRAFT=10
# Real mode: on = design with Gemini first when the school server has a Gemini key; off = Tripo only.
STAGING_GEMINI=on
# Crafts per day (server-wide / per account), new accounts' Starseeds, sign-up (false = invitation code only:
# ops/staging-secrets/registration-code, shared with the team only).
STAGING_CRAFTS_PER_DAY=200
STAGING_CRAFTS_PER_ACCOUNT_DAY=50
STAGING_WELCOME_STARS=1000
STAGING_OPEN_REGISTRATION=false
STAGING_SIGNUPS_PER_IP_DAY=20
# Container limits (production keeps its own 640m).
STAGING_MEMORY=320m
STAGING_CPUS=1.0
