# Development server settings. ops/install_staging.sh copies this to ops/staging.env in the staging
# checkout (/opt/villagen-staging) and fills VILLAGEN_PROD_DIR; ops/staging.sh changes the rest.
# Never put keys or invitation codes here.
# The school server checkout: its Tripo/Gemini key files are used only in real mode.
VILLAGEN_PROD_DIR=/home/ubuntu/tripo_s1
# fake = built-in stand-in for Tripo (free, instant); real = real Tripo within the budget below.
STAGING_CRAFT=fake
# Seconds a fake task "runs" before it finishes (0 = at once; try 20 to see the progress bar).
STAGING_FAKE_SECONDS=0
# Real mode only: Tripo credits the development server may spend in total, and per craft.
STAGING_TRIPO_BUDGET=0
STAGING_MAX_CREDITS_PER_CRAFT=10
# Real mode: on = design with Gemini first when the school server has a Gemini key; off = Tripo only.
STAGING_GEMINI=on
# Crafts per day (server-wide / per account), new accounts' Starseeds, sign-up (false = invitation code only:
# ops/staging-secrets/registration-code, shared with the team only).
STAGING_CRAFTS_PER_DAY=200
STAGING_CRAFTS_PER_ACCOUNT_DAY=50
STAGING_WELCOME_STARS=1000
# Residents' requests: their starseed rewards times this (0 = off).
STAGING_QUEST_STARS_SCALE=1.0
STAGING_OPEN_REGISTRATION=false
STAGING_SIGNUPS_PER_IP_DAY=20
# Container limits (production keeps its own 640m).
STAGING_MEMORY=320m
STAGING_CPUS=1.0
# Social layer (docs/design/SOCIAL_API.md, section 8). Uncomment to change; the values shown are
# the defaults. The update script passes this file to compose, which hands these to the API.
# Server-wide "everyone" chat channel: on or off (off leaves village, party and whispers).
# VILLAGEN_GLOBAL_CHAT=on
# Who appears in the online list: all, friends (friends and players in the same village) or off.
# VILLAGEN_SOCIAL_ROSTER=all
# Extra word list (syntax of server/data/chat_words.txt), a file name in the data volume (/data),
# read at start-up. Put it there with:
#   docker compose --env-file ops/staging.env -p villagen-staging --project-directory ops -f ops/compose.staging.yaml exec -T staging-api sh -c 'cat > /data/chat_words_extra.txt' < chat_words_extra.txt
# then set the name below and restart the API (sudo bash ops/staging.sh update --force; run the docker command in /opt/villagen-staging).
# VILLAGEN_CHAT_FILTER_EXTRA=chat_words_extra.txt
# Chat lines one address may send per minute (a school shares one address), hours lines are kept.
# VILLAGEN_CHAT_IP_PER_MINUTE=600
# VILLAGEN_CHAT_RETENTION_HOURS=24
# Presence poll advice (seconds: with others around, alone; the social window's list refresh) and
# the polls a second the server aims to carry; lower the budget if the CPU credit balance falls.
# VILLAGEN_PRESENCE_TOGETHER=0.25
# VILLAGEN_PRESENCE_ALONE=1
# VILLAGEN_PEOPLE_SECONDS=5
# VILLAGEN_PRESENCE_BUDGET=60
