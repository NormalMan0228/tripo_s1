# Copy to ops/production.env. Never put keys or invitation codes here.
# Tripo keys live in ops/secrets/tripo-key: one key per line, first line first; a craft
# moves to the next key when an account lacks credit, and each task keeps its key.
TRIPOTHON_DOMAIN=game.example.com
TRIPO_DAILY_REQUEST_LIMIT=5
TRIPO_USER_DAILY_REQUEST_LIMIT=2
TRIPO_RESERVE_PER_JOB=200
TRIPOTHON_STARS_PER_CREDIT=1
# Judging server: every account may start at most this many crafts in total (0 = off),
# and new accounts start with enough stars to craft right away (0 = earn them in survival).
TRIPO_USER_TOTAL_REQUEST_LIMIT=0
TRIPOTHON_WELCOME_STARS=0
# Selling at the village shop pays starseeds too: 1 per 3 leaf coins, at most 15 a day (0 = off).
TRIPOTHON_SELL_STARS_DAILY=15
TRIPOTHON_SELL_COINS_PER_STAR=3
# Residents' requests (부탁): their starseed rewards (server/quests.py STARS) times this, per account:
# 82 in all at 1.0, 164 at 2.0, 380 at 5 (the most; 노을's and 콩이's craft requests stop at 20 each).
# 0 turns the rewards off (the requests still run); at most 5.
TRIPOTHON_QUEST_STARS_SCALE=1.0
# Optional: Gemini models for the design step, tried in order.
# TRIPOTHON_GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite
# Open sign-up (no invitation code; the trial game has no code field): true lets anyone create an account,
# at most TRIPOTHON_SIGNUPS_PER_IP_DAY per address and TRIPOTHON_SIGNUPS_PER_DAY in total.
# Keep TRIPO_DAILY_REQUEST_LIMIT low then: it is the ceiling on Tripo spending per day.
TRIPOTHON_OPEN_REGISTRATION=true
TRIPOTHON_SIGNUPS_PER_IP_DAY=3
TRIPOTHON_SIGNUPS_PER_DAY=200
# Trial cap: most Tripo credits one craft may spend (10 = cheapest craft only, 0 = no cap).
TRIPOTHON_MAX_CREDITS_PER_CRAFT=10
# Tripo credits this server may spend in total; crafting stops when it is used up (0 = no budget).
TRIPOTHON_TRIPO_CREDIT_BUDGET=0
# Social layer (docs/design/SOCIAL_API.md, section 8). Uncomment to change; the values shown are
# the defaults. The update script passes this file to compose, which hands these to the API.
# Server-wide "everyone" chat channel: on or off (off leaves village, party and whispers).
# VILLAGEN_GLOBAL_CHAT=on
# Who appears in the online list: all, friends (friends and players in the same village) or off.
# VILLAGEN_SOCIAL_ROSTER=all
# Extra word list (syntax of server/data/chat_words.txt), a file name in the data volume (/data),
# read at start-up. Put it there with:
#   docker compose --env-file ops/production.env -f ops/compose.yaml -f ops/compose.gcp-free.yaml exec -T api sh -c 'cat > /data/chat_words_extra.txt' < chat_words_extra.txt
# then set the name below and restart the API (sudo bash ops/update_online_server.sh main, or up -d with the same files).
# VILLAGEN_CHAT_FILTER_EXTRA=chat_words_extra.txt
# Chat lines one address may send per minute (a school shares one address), hours lines are kept.
# VILLAGEN_CHAT_IP_PER_MINUTE=600
# VILLAGEN_CHAT_RETENTION_HOURS=24
# Presence poll advice (seconds: with others around, alone; the social window's list refresh) and
# the polls a second the server aims to carry; lower the budget if the CPU credit balance falls.
# VILLAGEN_PRESENCE_TOGETHER=0.25
# VILLAGEN_PRESENCE_ALONE=1
# VILLAGEN_PEOPLE_SECONDS=5
# VILLAGEN_PRESENCE_BUDGET=60
